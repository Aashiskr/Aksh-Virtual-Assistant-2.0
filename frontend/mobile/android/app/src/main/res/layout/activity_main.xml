<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/app_background"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="36dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@string/app_logo_description"
                android:src="@drawable/ic_aksh" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title"
                    android:textColor="@color/text_primary"
                    android:textSize="27sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/subtitle"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/status_pill_background"
            android:maxLines="2"
            android:text="@string/not_connected"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/connectionSettingsButton"
            style="@style/SecondaryButton"
            android:layout_width="match_parent"
            android:layout_marginTop="18dp"
            android:text="@string/connection_settings_show" />

        <LinearLayout
            android:id="@+id/pairingForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                style="@style/SectionLabel"
                android:text="@string/device_connection_label" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="@string/device_connection_helper"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/discoveryInput"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/input_background"
                android:hint="@string/discovery_hint"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:paddingHorizontal="15dp"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/deviceInput"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/input_background"
                android:hint="@string/device_hint"
                android:importantForAutofill="no"
                android:inputType="textNoSuggestions"
                android:paddingHorizontal="15dp"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/tokenInput"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/input_background"
                android:hint="@string/token_hint"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:paddingHorizontal="15dp"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/serverInput"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/input_background"
                android:hint="@string/server_hint"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:paddingHorizontal="15dp"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="13sp" />

            <Button
                android:id="@+id/saveButton"
                style="@style/PrimaryButton"
                android:layout_width="match_parent"
                android:layout_marginTop="12dp"
                android:text="@string/save_test" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/hero_background"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                style="@style/SectionLabel"
                android:text="@string/voice_command_label"
                android:textColor="@color/success" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/voice_command_heading"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/voice_command_helper"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/micButton"
                style="@style/PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:layout_marginTop="18dp"
                android:text="@string/start_listening"
                android:textSize="17sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="17dp"
                android:gravity="center"
                android:text="@string/or_type_command"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/commandInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/input_background"
                android:gravity="top|start"
                android:hint="@string/command_hint"
                android:imeOptions="actionSend"
                android:importantForAutofill="no"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLength="2000"
                android:maxLines="4"
                android:minHeight="88dp"
                android:minLines="2"
                android:padding="15dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="14sp" />

            <Button
                android:id="@+id/sendTextButton"
                style="@style/PrimaryButton"
                android:layout_width="match_parent"
                android:layout_marginTop="10dp"
                android:text="@string/send_command" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/meetingCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/meeting_card_background"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <TextView
                style="@style/SectionLabel"
                android:text="@string/meeting_ready_label"
                android:textColor="@color/success" />

            <TextView
                android:id="@+id/meetingTitleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/meetingDetailsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/meetingLinkText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:autoLink="web"
                android:linksClickable="true"
                android:textColor="@color/success"
                android:textIsSelectable="true"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/copyMeetingLinkButton"
                style="@style/PrimaryButton"
                android:layout_width="match_parent"
                android:layout_marginTop="14dp"
                android:backgroundTint="@color/success"
                android:enabled="false"
                android:text="@string/copy_meeting_link"
                android:textColor="#071711" />
        </LinearLayout>

        <TextView
            style="@style/SectionLabel"
            android:layout_marginTop="26dp"
            android:text="@string/quick_actions_label" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/remoteScreenButton"
                style="@style/SecondaryButton"
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/remote_screen_button" />

            <Button
                android:id="@+id/secureLoginButton"
                style="@style/SecondaryButton"
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/secure_remote_login_button" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/secure_remote_login_note"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                style="@style/SectionLabel"
                android:text="@string/career_updates_heading"
                android:textColor="@color/success" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/career_updates_profile"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <Switch
                android:id="@+id/careerUpdatesSwitch"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="6dp"
                android:text="@string/career_updates_toggle"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <Button
                android:id="@+id/careerBriefButton"
                style="@style/SecondaryButton"
                android:layout_width="match_parent"
                android:layout_marginTop="6dp"
                android:text="@string/career_view_latest" />
        </LinearLayout>

        <TextView
            style="@style/SectionLabel"
            android:layout_marginTop="26dp"
            android:text="@string/recent_activity_label" />

        <TextView
            android:id="@+id/heardText"
            style="@style/ReportCard"
            android:layout_marginTop="10dp"
            android:text="@string/waiting_for_command" />

        <TextView
            android:id="@+id/reportText"
            style="@style/ReportCard"
            android:layout_marginTop="10dp"
            android:text="@string/waiting_for_report" />
    </LinearLayout>
</ScrollView>
