# Optional environment overrides for Aksh 2.0.
#
# On Windows, the first-run dialog stores the Groq key encrypted with DPAPI.
# Set GROQ_API_KEY here only when environment-based configuration is preferred.
GROQ_API_KEY=
AKSH_GROQ_MODEL=openai/gpt-oss-20b
AKSH_GROQ_STT_MODEL=whisper-large-v3
AKSH_OWNER_NAME=

# Country code used when WhatsApp receives a bare 10-digit phone number.
AKSH_WHATSAPP_COUNTRY_CODE=91

# Optional fixed token. Leave blank to create a random DPAPI-protected token.
AKSH_REMOTE_TOKEN=

# Optional permanent HTTPS tunnel URL. Blank uses a Cloudflare Quick Tunnel.
AKSH_REMOTE_PUBLIC_URL=

# Deploy your own Worker from infrastructure/cloudflare/discovery-worker and
# paste its HTTPS URL here. There is intentionally no shared default relay.
AKSH_DISCOVERY_URL=
